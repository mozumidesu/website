{
  "name": "zolatau",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  // The hostnames this Worker answers on. Cloudflare creates the DNS records
  // and the certificates itself, on the first deploy.
  "routes": [
    { "pattern": "zolatau.com", "custom_domain": true },
    { "pattern": "www.zolatau.com", "custom_domain": true },
    { "pattern": "translate.zolatau.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index.html", "/translate", "/translate/*", "/builds", "/builds/*"]
  }
}
